// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gift {
  id                 String   @id @default(cuid())
  title              String
  description        String?
  image_url          String?
  price              Float
  status             String   @default("AVAILABLE") // Mantendremos esto por compatibilidad, pero la lógica real usará el stock
  stock              Int      @default(1)
  timesGifted        Int      @default(0)
  timesPending       Int      @default(0)
  isVisible          Boolean  @default(true)
  transfer_reference String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  contributions Contribution[]
}

/// Un aporte individual de un invitado a un regalo.
///
/// Existe para poder corregir el monto de una persona sin tocar a las demás:
/// los contadores del regalo (`timesGifted` / `timesPending`) siguen siendo la
/// fuente de verdad de la disponibilidad, y esta tabla es el detalle de quién
/// puso cuánto. Cada fila corresponde a una unidad reservada del regalo.
model Contribution {
  id        String   @id @default(cuid())
  giftId    String
  gift      Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  guestName String
  reference String
  /// Monto realmente transferido. Arranca en el precio del regalo y el
  /// administrador puede rectificarlo si la persona transfirió otra cosa.
  amount    Float
  status    String   @default("PENDING") // PENDING | CONFIRMED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([giftId])
  @@index([reference])
}

/// Suscripciones Web Push de los administradores. Una fila por dispositivo/navegador.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  label     String? // Para reconocer el dispositivo, ej. "iPhone de Ana"
  createdAt DateTime @default(now())
}

model Settings {
  id              String  @id @default(cuid())
  coupleNames     String  @default("Nuestros Nombres")
  coverPhotoUrl   String?
  avatarPhotoUrl  String?
  bankName        String  @default("Banco")
  bankAccount     String  @default("000000")
  bankHolder      String  @default("Titular")
  bankDocument    String  @default("0.000.000")
  bankAlias       String  @default("")
  galleryImages   String? // Can store a JSON array of strings: '["url1", "url2"]'
  weddingDate     String? // ISO date string e.g. "2025-11-15"
}
